{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "voice-notes",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	}
}
